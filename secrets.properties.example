# Copy to secrets.properties (never commit the real file).
# Register your own OAuth 2.0 application at
# https://www.openstreetmap.org/oauth2/applications (or the dev server equivalent).
# Mapeia uses PKCE as a public client, so no client secret is needed.

OSM_OAUTH_CLIENT_ID=your-client-id-here
OSM_API_BASE_URL=https://master.apis.dev.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
