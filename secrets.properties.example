# Copy to secrets.properties (never commit the real file).
# Every key is optional: without the file the app builds with empty client ids
# and the default URLs below, which is what CI does.
#
# Register your own OAuth 2.0 application on each server you use
# (Mapeia uses PKCE as a public client, so no client secret is needed):
#   dev:        https://master.apis.dev.openstreetmap.org/oauth2/applications
#   production: https://www.openstreetmap.org/oauth2/applications

# Which OSM server the app talks to: dev or production.
# Leave empty to use dev in debug builds and production in release builds.
OSM_SERVER=

OSM_DEV_OAUTH_CLIENT_ID=your-dev-client-id-here
OSM_PRODUCTION_OAUTH_CLIENT_ID=your-production-client-id-here

OVERPASS_API_URL=https://overpass-api.de/api/interpreter
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
